# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Stripe ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ─── Stripe Price IDs ────────────────────────────────────────
STRIPE_PRICE_WEEKDAY=price_1TBwJyCJiIAY18yYv2bLi3aD
STRIPE_PRICE_WEEKEND=price_1TBwInCJiIAY18yYwJSJKw26
STRIPE_PRICE_SIGNATURE=price_1T58qdCJiIAY18yY4JQFS8pb

# ─── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=bangkokclubcrawl@gmail.com
# Optional (Stage 10 Phase 6). BNT transactional email (confirmation/
# cancellation/reschedule/confirmed-meetup) sends from this address instead
# of RESEND_FROM when set. MUST be an address on a domain verified in this
# Resend account (SPF/DKIM) — a plain Gmail address (e.g.
# bestnightlifethailand@gmail.com) cannot be used as a "from" address.
# Until this is set and verified, BNT email still sends successfully — it
# falls back to RESEND_FROM's address with the correct "BEST Nightlife
# Thailand" display name, just not yet a bestnightlifethailand.com address.
# RESEND_FROM_BNT=booking@bestnightlifethailand.com

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bkkclubcrawl.com
# Optional (Stage 10 Phase 5/6). BNT-originated checkout success/cancel URLs
# and customer-facing ticket links resolve against this instead of
# NEXT_PUBLIC_APP_URL. Falls back to https://bestnightlifethailand.com if
# unset — aspirational until that domain is pointed at this Vercel project;
# harmless today since new-in-bkk stays Draft/invisible (no real traffic
# reaches this branch). On a Vercel Preview deployment this is ignored
# entirely — both storefronts resolve to the Preview's own URL.
# NEXT_PUBLIC_BNT_APP_URL=https://bestnightlifethailand.com
# Dashboard/admin access is Supabase Auth + the admin_users table (no shared
# password). Create an auth user, then add their id to admin_users.

# ─── Phase 2 checkout rollout ───────────────────────────────
# When "true", /api/create-checkout resolves price + validity from the Supabase
# Product/Event Instance (dynamic price_data). Any other value (or unset) uses
# the legacy STRIPE_PRICE_* path. This is the rollback/cutover switch.
CHECKOUT_DYNAMIC_PRICING=false
